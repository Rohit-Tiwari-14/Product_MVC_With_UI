<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit PAGE</title>
</head>
<body>
    <center>
        <h2>Edit Product</h2>
        <form action="/edit/<%= PrData._id %>?_method=patch" method="post">
            NAME:
            <input type="text" name="pname" id="" value="<%= PrData.pname %>"><br>
            <br>
            PRICE:
            <input type="text" name="price" id="" value="<%= PrData.price %>"><br>
            <br>
            CATEGORY:
            <input type="text" name="category" id="" value="<%= PrData.category %>"><br>
            <br>
            <button type="submit">SUBMIT</button>
        </form>
    </center>
</body>
</html>