<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=\, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <center>
        <h2>PRODUCT DETAILS &nbsp; &nbsp;<a href="/addPr">ADD PRODUCT</a></h2>
        <table border="3">
            <tr>
                <th>NAME</th>
                <th>PRICE</th>
                <th>CATEGORY</th>
                <th>Actions</th>
            </tr>
            <% result.forEach(d => { %>
                <tr>
                    <td><%= d.pname %></td>
                    <td><%= d.price %></td>
                    <td><%= d.category %></td>
                    <td>
                        <a href="/edit/<%= d._id %>">Edit</a>
                        <form action="/delete/<%= d._id %>?_method=delete" method="post" onsubmit="return confirm('Are you sure?')">
                            <button type="submit">Delete</button>
                        </form>
                    </td>
                </tr>
             
            <% }) %>
        </table>
    </center>
    
</body>
</html>